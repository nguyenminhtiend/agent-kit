#!/usr/bin/env bash
# agent-kit: the spec pipeline for a project, one step per command.
#   brief -> specs -> independent review -> task plan -> readiness -> human approval -> gate
# Each command runs one step and checks its inputs. You (or your own script)
# choose the order and the retries. Claude does the thinking inside a step.
set -euo pipefail

# Find the kit home (the folder with bin/, lib/, hooks/ ...), even when this
# file is reached through a symlink such as ~/.local/bin/agent-kit.
resolve_dir() {
  local p="$1" dir
  while [ -L "$p" ]; do
    dir="$(cd -P "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$dir/$p" ;; esac
  done
  cd -P "$(dirname "$p")" && pwd
}
AGENT_KIT_HOME="$(cd "$(resolve_dir "${BASH_SOURCE[0]}")/.." && pwd)"
export AGENT_KIT_HOME

for f in common engine init spec review plan gate doctor; do
  # shellcheck source=/dev/null
  source "$AGENT_KIT_HOME/lib/$f.sh"
done

usage() {
  cat <<'EOF'
Usage: agent-kit [--workspace DIR] <command> [options]

  --workspace DIR, -w DIR
                         Folder for brief/, docs/, tasks/ and .workflow/, relative
                         to the project root. Default: [paths] workspace in
                         agent-kit.toml, else the project root. Use one per feature.

Setup
  init [--dir DIR]       Add agent-kit.toml, AGENTS.md, CLAUDE.md, and the workspace
                         with its brief template and folders
  doctor                 Check that the needed tools are installed

Steps (run inside a project, one at a time, in this order)
  spec STAGE             A. Run one spec stage; it writes one document in docs/
  review                 B. One review round by read-only reviewers in parallel
                            exit 2 = blocking findings: run repair, then review again
  repair                 B. Fix the blocking findings of the last review
  plan                   C. Write docs/07 plan and tasks/ (needs a passed review)
  readiness              C. Write docs/08 and the verdict; exit 2 = NOT_READY
  approve                D. A person approves the current baseline (brief, docs, tasks)
  gate                   D. Hard checks; exit 0 only when ready AND approved

  Exit codes: 0 = done, 1 = error or missing input, 2 = the step found work to do.

Other
  version                Print the kit version
  help                   Show this help

Spec stages, in order: discover, define-product, design-ux, design-architecture,
                       design-technical, validate-feasibility
EOF
}

# --workspace may appear anywhere, so the scripts/*.sh wrappers accept it too.
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -w|--workspace) [ $# -ge 2 ] || die "--workspace needs a folder"; export AGENT_KIT_WORKSPACE="$2"; shift 2 ;;
    --workspace=*)  export AGENT_KIT_WORKSPACE="${1#*=}"; shift ;;
    *)              args+=("$1"); shift ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  init)            ak_init "$@" ;;
  doctor)          ak_doctor "$@" ;;
  spec)            need_tools claude jq yq; ak_spec "$@" ;;
  review)          need_tools claude jq yq; ak_review "$@" ;;
  repair)          need_tools claude jq yq; ak_repair "$@" ;;
  plan)            need_tools claude jq yq; ak_plan "$@" ;;
  readiness)       need_tools claude jq yq; ak_readiness "$@" ;;
  gate)            need_tools jq yq; ak_gate "$@" ;;
  approve)         need_tools jq yq; ak_approve "$@" ;;
  version)         cat "$AGENT_KIT_HOME/VERSION" ;;
  help|-h|--help)  usage ;;
  *)               usage >&2; die "unknown command: $cmd" ;;
esac
